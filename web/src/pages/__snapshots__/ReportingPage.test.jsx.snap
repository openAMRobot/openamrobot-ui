exports[`Reporting Mode page DISCONNECTED when rosbridge is down: DISCONNECTED 1`] = `
<div
  class="relative flex h-screen w-screen flex-col overflow-hidden font-[RobotoMono]"
  data-state="DISCONNECTED"
  data-testid="reporting-page"
  style="background: rgb(17, 17, 17); color: rgb(255, 255, 255);"
>
  <button
    aria-label="Hold to exit Reporting Mode"
    class="absolute right-4 top-4 rounded-lg border px-4 py-3 border-white/30 bg-black/30 select-none text-white/80"
    style="font-size: 20px;"
    type="button"
  >
    Hold to exit
  </button>
  <header
    class="flex items-center gap-6 px-10 pt-6"
    style="font-size: 28px;"
  >
    <span
      class="font-semibold"
    >
      Base and navigation
    </span>
    <span
      class="text-white/60"
      style="font-size: 20px;"
    >
      Navigation status covers navigation only. It is not whole-robot readiness or E-stop state.
    </span>
  </header>
  <main
    class="grid flex-1 grid-cols-2 gap-10 px-10 py-6"
  >
    <section
      aria-label="Robot state"
    >
      <h1
        class="font-bold leading-none"
        data-testid="reporting-state"
        style="font-size: 120px; color: rgb(156, 163, 175);"
      >
        DISCONNECTED
      </h1>
      <p
        class="mt-6 font-semibold"
        data-testid="reporting-reason"
        style="font-size: 44px;"
      >
        No connection to the robot
      </p>
      <p
        class="mt-4 text-white/90"
        data-testid="reporting-next"
        style="font-size: 32px;"
      >
        Next: 
        Check the panel's network connection. It reconnects on its own.
      </p>
    </section>
    <section
      aria-label="Task and result"
      class="flex flex-col gap-5"
      style="font-size: 28px;"
    >
      <div
        data-testid="reporting-task"
      >
        <p
          class="text-white/60"
          style="font-size: 20px;"
        >
          Current task
        </p>
        <p
          class="text-white/70"
        >
          None
        </p>
      </div>
      <div
        data-testid="reporting-result"
      >
        <p
          class="text-white/60"
          style="font-size: 20px;"
        >
          Last result
        </p>
        <p
          class="text-white/70"
        >
          None
        </p>
      </div>
      <div
        data-testid="reporting-warnings"
      >
        <p
          class="text-white/60"
          style="font-size: 20px;"
        >
          Warnings
        </p>
        <p
          class="text-white/70"
        >
          None
        </p>
      </div>
    </section>
  </main>
  <footer
    class="grid grid-cols-3 gap-x-10 gap-y-2 border-t border-white/20 px-10 py-4"
    style="font-size: 24px;"
  >
    <div
      class="flex justify-between gap-4"
      data-testid="row-Connection"
    >
      <span
        class="text-white/70"
      >
        Connection
      </span>
      <span
        class="font-semibold"
      >
        Disconnected
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Software stop lock"
    >
      <span
        class="text-white/70"
      >
        Software stop lock
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Navigation"
    >
      <span
        class="text-white/70"
      >
        Navigation
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Localization"
    >
      <span
        class="text-white/70"
      >
        Localization
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Battery"
    >
      <span
        class="text-white/70"
      >
        Battery
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Diagnostics"
    >
      <span
        class="text-white/70"
      >
        Diagnostics
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Arms"
    >
      <span
        class="text-white/70"
      >
        Arms
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Lift"
    >
      <span
        class="text-white/70"
      >
        Lift
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <div
      class="flex justify-between gap-4"
      data-testid="row-Physical E-stop"
    >
      <span
        class="text-white/70"
      >
        Physical E-stop
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <div
      class="col-span-3 mt-2 flex items-center justify-between text-white/60"
      style="font-size: 20px;"
    >
      <span>
        Screen wake lock: 
        not supported
      </span>
      <button
        aria-pressed="false"
        class="rounded-lg border border-white/30 px-4 py-3 text-white"
        style="font-size: 20px;"
        type="button"
      >
        Speech off
      </button>
    </div>
  </footer>
</div>
`;

