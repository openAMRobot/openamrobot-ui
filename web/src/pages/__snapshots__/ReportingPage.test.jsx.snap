// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Reporting Mode page DISCONNECTED when rosbridge is down: DISCONNECTED 1`] = `
<div
  class="relative flex h-screen w-screen flex-col overflow-hidden font-[RobotoMono]"
  data-state="DISCONNECTED"
  data-testid="reporting-page"
  style="background: rgb(17, 17, 17); color: rgb(255, 255, 255);"
>
  <header
    class="flex items-start justify-between"
    data-testid="reporting-header"
    style="gap: min(24px, 2vw);"
  >
    <div
      class="flex min-w-0 flex-col gap-1"
    >
      <span
        class="font-semibold"
      >
        Base and navigation
      </span>
      <span
        class="text-white/60"
      >
        Navigation status covers navigation only. It is not whole-robot readiness or E-stop state.
      </span>
    </div>
    <button
      aria-label="Hold to exit Reporting Mode"
      class="shrink-0 rounded-lg border px-4 border-white/30 bg-black/30 select-none text-white/80"
      style="min-height: 48px;"
      type="button"
    >
      Hold to exit
    </button>
  </header>
  <main
    class="flex min-h-0 flex-1 flex-col overflow-y-auto"
    data-testid="reporting-main"
    style="gap: min(40px, 3.3333vw);"
  >
    <section
      aria-label="Robot state"
      style="overflow-wrap: anywhere;"
    >
      <div
        class="mb-4 border-2 border-white/60 bg-black px-4 py-3 font-bold"
        data-testid="reporting-disconnected-banner"
        role="status"
      >
        Disconnected
         
        · 
        Last known state
        :
         
        <span
          data-testid="reporting-last-known-state"
        >
          UNKNOWN
        </span>
      </div>
      <h1
        class="flex items-center gap-3 font-bold leading-none"
        data-testid="reporting-state"
        style="color: rgb(209, 213, 219);"
      >
        <svg
          aria-hidden="true"
          data-icon="DISCONNECTED"
          data-testid="reporting-state-icon"
          focusable="false"
          style="width: 0.6em; height: 0.6em; flex-shrink: 0;"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 6l12 12M18 6 6 18"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
          />
        </svg>
        <span>
          DISCONNECTED
        </span>
      </h1>
      <p
        class="mt-6 font-semibold"
        data-testid="reporting-reason"
      >
        No connection to the robot
      </p>
      <p
        class="mt-4 text-white/90"
        data-testid="reporting-next"
      >
        Next:
         
        Check the panel's network connection. It reconnects on its own.
      </p>
    </section>
    <section
      aria-label="Task and result"
      class="flex min-w-0 flex-col gap-5"
      style="overflow-wrap: anywhere;"
    >
      <div
        class="flex flex-col gap-5 "
        data-testid="reporting-task-block"
      >
        <div
          data-testid="reporting-task"
        >
          <p
            class="text-white/60"
          >
            Current task
          </p>
          <p
            class="text-white/70"
          >
            None
          </p>
        </div>
      </div>
      <div
        data-testid="reporting-result"
      >
        <p
          class="text-white/60"
        >
          Last result
        </p>
        <p
          class="text-white/70"
        >
          No result yet
        </p>
      </div>
      <div
        data-testid="reporting-warnings"
      >
        <p
          class="text-white/60"
        >
          Warnings
        </p>
        <p
          class="text-white/70"
        >
          None
        </p>
      </div>
    </section>
  </main>
  <footer
    class="grid grid-cols-2 border-t border-white/20"
    data-testid="reporting-footer"
    style="column-gap: min(40px, 3.3333vw); row-gap: min(8px, 0.6667vw);"
  >
    <div
      class="flex justify-between gap-4 "
      data-testid="row-Connection"
    >
      <span
        class="text-white/70"
      >
        Connection
      </span>
      <span
        class="font-semibold"
      >
        Disconnected
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-freshness="No data"
      data-testid="row-Software stop lock"
    >
      <span
        class="text-white/70"
      >
        Software stop lock
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-freshness="No data"
      data-testid="row-Navigation"
    >
      <span
        class="text-white/70"
      >
        Navigation
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-freshness="No data"
      data-testid="row-Localization"
    >
      <span
        class="text-white/70"
      >
        Localization
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-freshness="No data"
      data-testid="row-Battery"
    >
      <span
        class="text-white/70"
      >
        Battery
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-freshness="No data"
      data-testid="row-Diagnostics"
    >
      <span
        class="text-white/70"
      >
        Diagnostics
      </span>
      <span
        class="font-semibold"
      >
        Unknown
         (no data)
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-testid="row-Arms"
    >
      <span
        class="text-white/70"
      >
        Arms
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-testid="row-Lift"
    >
      <span
        class="text-white/70"
      >
        Lift
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <div
      class="flex justify-between gap-4 "
      data-testid="row-Physical E-stop"
    >
      <span
        class="text-white/70"
      >
        Physical E-stop
      </span>
      <span
        class="font-semibold"
      >
        Not reported
      </span>
    </div>
    <p
      aria-live="polite"
      class="col-span-2 mt-2"
      data-testid="reporting-speech-text"
      role="status"
      style="overflow-wrap: anywhere;"
    >
      Last announcement
       (
      <span
        data-testid="reporting-speech-time"
      >
        09:41:05
      </span>
      ): 
      disconnected. No connection to the robot
    </p>
    <div
      class="col-span-2 flex items-center justify-between text-white/60"
    >
      <span>
        Screen wake lock
        : 
        not supported
      </span>
      <button
        aria-pressed="false"
        class="rounded-lg border border-white/30 px-4 text-white"
        data-testid="speech-toggle"
        style="min-height: 48px;"
        type="button"
      >
        Speech off
      </button>
    </div>
  </footer>
</div>
`;

