      <button
        aria-pressed="false"
        class="rounded-lg border border-white/30 px-4 text-white"
        data-testid="speech-toggle"
        style="min-height: 48px;"
        type="button"
      >
        Speech off
      </button>
    </div>
  </footer>
</div>
`;
